# Copy to .env for local development. Never commit real values.
PORT=8080
APP_URL=http://localhost:5173
# memory (default for local) or firestore
DATA_BACKEND=memory
GOOGLE_CLOUD_PROJECT=
# Gemini (optional locally: every AI feature falls back to rules without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Gmail SMTP with an app password (optional locally: emails are logged instead)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 32+ random characters each: openssl rand -base64 48
SESSION_SECRET=
LINK_SECRET=
# Reminder trigger auth: Cloud Scheduler service account email (production) or a shared secret (local)
SCHEDULER_SA=
TICK_SECRET=
